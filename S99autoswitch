#!/bin/sh
# ==============================================================================
# KeeneticAutoSwitchDNS - Entware Init Script (/opt/etc/init.d/S99autoswitch)
# ==============================================================================

ENABLED=yes
PROCS="autoswitch.sh"
PIDFILE="/opt/var/run/autoswitch.pid"
SCRIPT="/opt/bin/autoswitch.sh"
ARGS="both AutoSwitchDNS --loop 60"

start() {
    mkdir -p /opt/var/run 2>/dev/null
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "AutoSwitchDNS is already running (PID: $(cat "$PIDFILE"))"
        return 0
    fi

    echo -n "Starting AutoSwitchDNS daemon... "
    "$SCRIPT" $ARGS >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    echo "done. (PID: $(cat "$PIDFILE"))"
}

stop() {
    echo -n "Shutting down AutoSwitchDNS... "
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID" 2>/dev/null
            # Also kill any child sleeps or pings
            killall autoswitch.sh 2>/dev/null
            rm -f "$PIDFILE"
            echo "done."
            return 0
        fi
        rm -f "$PIDFILE"
    fi
    killall autoswitch.sh 2>/dev/null
    echo "done."
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "AutoSwitchDNS is running (PID: $(cat "$PIDFILE"))"
    elif pgrep -f "autoswitch.sh" >/dev/null 2>&1; then
        echo "AutoSwitchDNS is running (detected by process name)"
    else
        echo "AutoSwitchDNS is stopped"
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

